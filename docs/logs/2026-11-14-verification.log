[2026-11-14 15:06:54 +08:00] node - (Markdown relative-link and whitespace scan; source below)
const fs = require('node:fs');
const path = require('node:path');
const files = ['README.md', 'ROADMAP.md', 'PROJECT_CONTEXT.md', 'VIEWER_INNOVATION.md', 'PRODUCT.md', 'CHANGELOG.md', 'DEPLOYMENT.md', 'docs/VIEWER_MODERNIZATION_PLAN.md', 'docs/DEVELOPMENT_LOG.md'];
let count = 0;
const missing = [];
const whitespace = [];
for (const file of files) {
  const body = fs.readFileSync(file, 'utf8');
  body.split(/\r?\n/).forEach((line, index) => {
    if (/[\t ]+$/.test(line)) whitespace.push(file + ':' + (index + 1));
  });
  for (const match of body.matchAll(/\[[^\]]*\]\(([^\s)]+)(?:\s+"[^"]*")?\)/g)) {
    let target = match[1].replace(/^<|>$/g, '');
    if (/^(?:[a-z][a-z0-9+.-]*:|#|\/\/)/i.test(target)) continue;
    target = decodeURIComponent(target.split(/[?#]/)[0]);
    if (!target) continue;
    count++;
    if (!fs.existsSync(path.resolve(path.dirname(file), target))) missing.push(file + ': ' + target);
  }
}
console.log('Markdown files checked: ' + files.length);
console.log('Relative link targets checked: ' + count);
console.log('Missing targets: ' + missing.length);
console.log('Lines with trailing whitespace: ' + whitespace.length);
console.log('Scope: local file targets only; anchors and external URLs excluded.');
missing.concat(whitespace).forEach(item => console.log(item));
process.exitCode = missing.length || whitespace.length ? 1 : 0;
